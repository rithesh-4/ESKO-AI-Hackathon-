# --- LLM backend: any OpenAI-compatible provider (generic vars) ---
# Pick ONE provider block, fill the key, leave the rest commented.
# The app uses LLM_* when set, else falls back to NVIDIA_* aliases, else offline-rules.

# Option A: Groq — free tier, very fast. Key at console.groq.com
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Option B: Google AI Studio (Gemini) — generous free tier. Key at aistudio.google.com
#LLM_API_KEY=
#LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#LLM_MODEL=gemini-2.0-flash

# Option C: Cerebras — free tier, fastest inference. Key at cloud.cerebras.ai
#LLM_API_KEY=
#LLM_BASE_URL=https://api.cerebras.ai/v1
#LLM_MODEL=llama-3.3-70b

# Option D: OpenRouter — free :free models, no card. Key at openrouter.ai
#LLM_API_KEY=
#LLM_BASE_URL=https://openrouter.ai/api/v1
#LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Option E: NVIDIA NIM — free trial (~40 req/min). Key at build.nvidia.com
# NOTE: account entitlements vary; meta/llama-3.3-70b-instruct is retired (410).
# Verified live IDs include nvidia/nemotron-3-ultra-550b-a55b (slow on free tier),
# openai/gpt-oss-20b, meta/muse-glimmer-30b.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: request timeout in seconds (default 120)
#LLM_TIMEOUT=120

# App works offline without any key (backend shows offline-rules).
