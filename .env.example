# --- LLM backend: NVIDIA NIM ---
# Pick this provider block, fill the key, leave the rest commented.
# The app uses NVIDIA_* aliases, else offline-rules.

# Option A: NVIDIA NIM — free trial (~40 req/min). Key at build.nvidia.com
# NOTE: account entitlements vary; meta/llama-3.3-70b-instruct is retired (410).
# Verified live IDs include nvidia/nemotron-3-ultra-550b-a55b (slow on free tier),
# openai/gpt-oss-20b, meta/muse-glimmer-30b.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Optional: request timeout in seconds (default 120)
#LLM_TIMEOUT=120

# App works offline without any key (backend shows offline-rules).
